.docbuild/
target/
node_modules/
artifacts/
logs/
*.log
!docs/evidence/**/*.log
.venv/
__pycache__/
.DS_Store

# pabot / Robot Framework 运行产物（每次执行都会变，不入库）
.pabotsuitenames
pabot_results/
selenium-screenshot-*.png

# 本地开发文档（不上 GitHub）
AGENTS.md
.chrome-profile/

# 前端构建产物：环境基线 §102 不入库（2026-11-04 大师拍板）
frontend/dist/

# 关于页构建信息：由 scripts/gen_build_info.py 在打包时生成，属构建产物不是源码
backend/src/main/resources/build-info.properties

# UX-04 两页试点隔离工程：源码与 package-lock 入库（可复现），依赖与构建产物不入库
docs/design/pilot/node_modules/
docs/design/pilot/dist/

# 部署/回滚备份与发版产物：体积大且可按脚本重建（A6 收口 2026-11-07）
/backups/
/releases/

# 工作区运行数据（用户上传/导出/任务产物）：不入库，由 backup.sh 归档
/workspace/

# 契约脚本的默认工作区根（含 .signing-key 与 e2e 夹具）：运行时生成，严禁入库
/backend/workspace/

# 备份/升级演练的 dump 文件：18M 级体积，可由 scripts/ops/backup-drill.sh 重建；
# 只保留同目录的 .log / .json 摘要作为证据（2026-11-16 大师拍板）
docs/evidence/**/raw/backup-drill-*.sql

# 版本流程的草稿暂存区：PRD/DEV-PLAN/TEST-PLAN 三份一版在此开工，
# 进测试执行后移入 docs/release/vX.Y.0/ 补六份才算交付物；草稿属过程产物不入库
docs/release/_draft/
