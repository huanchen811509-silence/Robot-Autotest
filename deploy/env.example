# AIDC AutoTest 运行环境模板（交付包 deploy/env.example）
#
# 用法：复制到 ~/.config/robot-autotest/env，填好数据库口令后 chmod 600。
# 本文件只放键名与占位值；**任何真实口令都不得写进仓库或交付包**。
# 键名由 scripts/ops/common.sh 的 load_env() 逐行读取（不 source、不执行 shell）。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=robot_dev
DB_USERNAME=robot
DB_PASSWORD=

# 可选：统一入口与后端端口（默认 8001 / 8081）
ENTRY_PORT=8001
BACKEND_PORT=8081

# 可选：运行期版本覆盖（留空则读交付包 VERSION / build-info.properties）
APP_VERSION=

# 可选：测试内核可执行文件路径，按项目实际环境填写
EXECUTION_PYTEST_BIN=
