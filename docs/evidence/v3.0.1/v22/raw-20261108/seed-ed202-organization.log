===== 0. 项目创建（HTTP）与幂等 =====
# 项目由脚本经 POST /api/projects 创建（非 JDBC 塞表）；audit_log 有 project:create 记录，
# 该记录由 ProjectService.create 写入，是「走的是应用链路」的直接证据：
$ select id, actor_id, action, resource_type, resource_id, summary, occurred_at from audit_log
  where action='project:create' and resource_id='77';
1705729	17	project:create	project	77	after={code=ED202-COMMON; name=ED202 公共用例库; owner=17}; created=true	2026-11-08 08:41:26.547
# 同参数重放（code 是唯一键，重放应 409；证明项目确由 HTTP 创建，未用 JDBC 塞 project 表）：
$ curl -s -o - -w 'status=%{http_code}' -X POST -H 'Content-Type: application/json' \
      -d '{"code":"ED202-COMMON","name":"ED202 公共用例库",...}' http://127.0.0.1:8001/api/projects
status=409
{"code":40900,"codeName":"CONFLICT","message":"项目编码已存在：ED202-COMMON","data":null,"success":false}
$ curl -s -o - -w 'status=%{http_code}' -H 'Authorization: Bearer <token>' http://127.0.0.1:8001/api/projects/77
status=200
{"id": 77, "code": "ED202-COMMON", "name": "ED202 公共用例库", "enabled": true}

