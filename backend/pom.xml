<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.qa</groupId>
  <artifactId>robot-autotest-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>robot-autotest-backend</name>
  <description>自动化测试平台后端（v0.1 地基：分层骨架 + ArchUnit + 统一响应）</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.3.0</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- 集成测试默认跳过；`mvn -Pit test` 才跑（ADR-0002） -->
    <excluded.groups>it</excluded.groups>
    <groups></groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 只有 DataSource 与 Flyway 需要，不在 v0.1 引入 JPA（domain 保持纯 POJO） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- EXE-04 实时日志 WebSocket（spring-websocket 由 BOM 管版本） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- EW32-07：只暴露 health/info/metrics，不引入 Prometheus registry（D32-1 已批准） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- CAS-03：461 条台账 Excel 导入（本地 m2 已有 5.2.5，无需联网） -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit 元测试的违规 fixture 需要 JPA 注解（只用于证明规则能拦住） -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- WS-02 后端静态检查：真实阻断，规则见 config/checkstyle.xml -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>config/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${groups}</groups>
          <excludedGroups>${excluded.groups}</excludedGroups>
          <!--
            必须显式声明包含 *IT.java。surefire 默认只扫 Test* / *Test / *Tests / *TestCase，
            不含 *IT —— 那是 failsafe 的命名约定。于是 `mvn -Pit test` 会显示
            「Tests run: 0 / BUILD SUCCESS」：看着通过，实际一个集成测试都没跑
            （2026-11-04 实测到，SchemaIT 15 条一次都没被执行过）。
            默认 profile 靠 excluded.groups=it 把它们排除在外，所以这里放进来是安全的。
          -->
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- 覆盖率只统计不设红线（FR-v0.1-18，P2）：报告落 target/site/jacoco -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- destfile 指向临时目录：Windows 下工作目录含中文时，fork 出的 JVM 命令行会把它编码成乱码，
               导致 jacoco.exec 落到不存在的路径、报告为空。临时目录是 ASCII，跨平台稳定。 -->
          <destFile>${java.io.tmpdir}/jacoco-robot-autotest.exec</destFile>
        </configuration>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <dataFile>${java.io.tmpdir}/jacoco-robot-autotest.exec</dataFile>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Flyway 走 Maven 插件而不是应用启动时自动跑：DDL 变更不跟应用发布绑死 -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <url>jdbc:mariadb://${env.DB_HOST}:${env.DB_PORT}/${env.DB_NAME}</url>
          <user>${env.DB_USERNAME}</user>
          <password>${env.DB_PASSWORD}</password>
          <locations>
            <location>filesystem:${project.basedir}/../db/migration</location>
          </locations>
          <cleanDisabled>false</cleanDisabled>
          <!--
            关掉占位符替换。本项目迁移脚本不用 Flyway 占位符，但 V2_5 的注释里
            写了「面板据此补 ${} 占位符」这句说明，Flyway 10.x 会把它当成空名占位符
            并直接失败（No value provided for placeholder: ${}）。
            不改 SQL 而改配置：改 SQL 会变更 checksum，已迁移过的库（robot_dev 到 V7_1）
            会在下次启动时报 checksum 不一致，代价更大。
          -->
          <placeholderReplacement>false</placeholderReplacement>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- CI / 本地显式跑集成测试：mvn -B -Pit test（ADR-0002，需真实 MariaDB 的 robot_it 库） -->
    <profile>
      <id>it</id>
      <properties>
        <excluded.groups></excluded.groups>
        <groups>it</groups>
      </properties>
    </profile>
  </profiles>
</project>
